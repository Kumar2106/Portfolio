{
  "name": "portfolio-contact-service",
  "version": "1.0.0",
  "description": "Serverless contact form API with AWS Lambda, API Gateway, and SES (AWS SAM)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "sam:build": "sam build",
    "sam:deploy": "sam deploy",
    "sam:local": "sam local start-api --port 3000"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.758.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
